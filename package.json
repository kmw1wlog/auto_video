{
  "name": "market-detective-reels",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/api/server.ts",
    "market-detective:sample": "tsx src/workflow/runLocalPipeline.ts",
    "market-detective:reference": "tsx src/workflow/analyzeReferenceVideo.ts && tsx src/workflow/runLocalPipeline.ts",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "test:all": "vitest run",
    "check": "npm run test:all && npm run market-detective:sample"
  },
  "dependencies": {
    "express": "^4.19.2",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^1.6.0"
  }
}
